<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crear Cuenta"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/verde_tienda"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Regístrate para empezar a comprar"
        android:textSize="14sp"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etNuevoUsuario"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nombre de usuario"
        android:inputType="textPersonName"
        android:drawableStart="@drawable/outline_account_circle_24"
        android:drawablePadding="10dp"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/etNuevoPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:layout_marginTop="15dp"
        android:drawableStart="@android:drawable/ic_lock_idle_lock"
        android:drawablePadding="10dp"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/etConfirmarPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Confirmar contraseña"
        android:inputType="textPassword"
        android:layout_marginTop="15dp"
        android:drawableStart="@android:drawable/ic_lock_lock"
        android:drawablePadding="10dp"
        android:importantForAutofill="no" />

    <Button
        android:id="@+id/btnFinalizarRegistro"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Registrarme"
        android:backgroundTint="@color/verde_tienda"
        android:textColor="@android:color/white"
        android:layout_marginTop="30dp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvVolverLogin"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="¿Ya tienes cuenta? Inicia sesión"
        android:layout_marginTop="20dp"
        android:textColor="@color/verde_oscuro"
        android:textStyle="bold"/>

</LinearLayout>